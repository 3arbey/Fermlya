doctype html
html(lang=lang || "fr", dir=dir || "ltr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= pageTitle || "Mes soins — Soins à domicile & Garde malades au Maroc | Infirmiers de confiance"
    meta(name="description", content=pageDescription || "Mes soins met en relation les familles au Maroc avec des infirmiers diplômés d'État et garde-malades qualifiés à domicile (Casablanca, Rabat, Marrakech, Tanger...).")
    meta(name="keywords", content="soins, infirmier, infirmiere, domicile, فرملي, فرملة, ممرضة, تمريض منزلي, mes soins, messoins.com, soins a domicile maroc, infirmier a domicile casablanca, garde malade rabat, aide soignante domicile maroc")
    
    // SEO Canonical & Hreflang Tags
    link(rel="canonical", href=canonicalUrl || "https://messoins.com/")
    link(rel="alternate", hreflang="fr-MA", href="https://messoins.com/index.html")
    link(rel="alternate", hreflang="ar-MA", href="https://messoins.com/ar.html")
    link(rel="alternate", hreflang="en-MA", href="https://messoins.com/en.html")
    link(rel="alternate", hreflang="x-default", href="https://messoins.com/index.html")

    // OpenGraph & Social Media
    meta(property="og:title", content=pageTitle || "Mes soins — Soins & Aide à la personne de confiance au Maroc")
    meta(property="og:description", content=pageDescription || "Plateforme n°1 au Maroc de mise en relation entre familles et infirmiers / garde-malades qualifiés à domicile.")
    meta(property="og:type", content="website")
    meta(property="og:url", content=canonicalUrl || "https://messoins.com/")
    meta(property="og:image", content="./assets/images/hero-messoins.jpg")
    meta(property="og:locale", content=lang === "ar" ? "ar_MA" : (lang === "en" ? "en_US" : "fr_MA"))

    // Google Fonts: Fraunces (Editorial Warm Serif) + Nunito Sans + Cairo (Arabic)
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Fraunces:opsz,wght@9..144,400;500;600;700&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap", rel="stylesheet")

    // Main Stylesheet
    link(rel="stylesheet", href="./assets/css/main.css")

    // Structured Data JSON-LD for SEO & Rich Results
    script(type="application/ld+json").
      {
        "@context": "https://schema.org",
        "@type": "MedicalBusiness",
        "name": "messoins.com",
        "alternateName": ["Mes Soins Maroc", "مـي صـوان"],
        "url": "https://messoins.com",
        "logo": "https://messoins.com/assets/images/hero-messoins.jpg",
        "image": "https://messoins.com/assets/images/hero-messoins.jpg",
        "description": "Plateforme n°1 de mise en relation pour soins infirmiers à domicile et garde-malades qualifiés au Maroc.",
        "priceRange": "150 DH - 3500 DH",
        "telephone": "+212522889900",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Casablanca",
          "addressCountry": "MA"
        },
        "areaServed": [
          {"@type": "City", "name": "Casablanca"},
          {"@type": "City", "name": "Rabat"},
          {"@type": "City", "name": "Marrakech"},
          {"@type": "City", "name": "Tanger"},
          {"@type": "City", "name": "Agadir"},
          {"@type": "City", "name": "Fès"},
          {"@type": "City", "name": "Meknès"},
          {"@type": "City", "name": "Oujda"}
        ]
      }

  body
    // Hidden Netlify Forms setup for Static Parser Indexing
    form(name="client-leads", netlify, netlify-honeypot="bot-field", hidden)
      input(type="text", name="form-name", value="client-leads")
      input(type="text", name="bot-field")
      input(type="text", name="fullName")
      input(type="tel", name="phone")
      input(type="text", name="city")
      input(type="text", name="serviceType")
      input(type="text", name="urgency")
      textarea(name="details")

    form(name="caregiver-leads", netlify, netlify-honeypot="bot-field", hidden)
      input(type="text", name="form-name", value="caregiver-leads")
      input(type="text", name="bot-field")
      input(type="text", name="fullName")
      input(type="tel", name="phone")
      input(type="text", name="profession")
      input(type="text", name="city")
      input(type="text", name="experience")
      textarea(name="bio")

    // Header Navigation
    include ../includes/header.pug

    // Main Page Content
    main#main-content
      block content

    // Lead Capture Modal Window
    include ../includes/lead-forms.pug

    // Footer
    include ../includes/footer.pug

    // Main JS Logic
    script(src="./assets/js/main.js")
