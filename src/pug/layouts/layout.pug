doctype html
html(lang=lang || "fr", dir=dir || "ltr")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= pageTitle || "Fermlya (فَرْمْلِيَة) — Mise en relation soins & aide à la personne au Maroc"
    meta(name="description", content=pageDescription || "Fermlya met en relation les professionnels de l'aide à la personne et de la santé (infirmiers, garde-malades) avec les familles au Maroc.")
    meta(name="keywords", content="fermlya, soinline, garde malade casablanca, infirmier a domicile maroc, soins a domicile rabat, infirmiere marrakech")
    
    // SEO Canonical & Hreflang Tags
    link(rel="canonical", href=canonicalUrl || "https://fermlya.netlify.app/")
    link(rel="alternate", hreflang="fr-MA", href="https://fermlya.netlify.app/index.html")
    link(rel="alternate", hreflang="ar-MA", href="https://fermlya.netlify.app/ar.html")
    link(rel="alternate", hreflang="en-MA", href="https://fermlya.netlify.app/en.html")
    link(rel="alternate", hreflang="x-default", href="https://fermlya.netlify.app/index.html")

    // OpenGraph & Social Media
    meta(property="og:title", content=pageTitle || "Fermlya — Soins & Aide à la personne de confiance au Maroc")
    meta(property="og:description", content=pageDescription || "Mise en relation entre familles et professionnels de la santé et du soin à domicile au Maroc.")
    meta(property="og:type", content="website")
    meta(property="og:url", content=canonicalUrl || "https://fermlya.netlify.app/")
    meta(property="og:image", content="./assets/images/hero-caregiver.jpg")
    meta(property="og:locale", content=lang === "ar" ? "ar_MA" : (lang === "en" ? "en_US" : "fr_MA"))

    // Google Fonts: Fraunces (Editorial Warm Serif) + Nunito Sans + Cairo (Arabic)
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Fraunces:opsz,wght@9..144,400;500;600;700&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap", rel="stylesheet")

    // Main Stylesheet
    link(rel="stylesheet", href="./assets/css/main.css")

    // Structured Data JSON-LD
    script(type="application/ld+json").
      {
        "@context": "https://schema.org",
        "@type": "MedicalOrganization",
        "name": "Fermlya (فَرْمْلِيَة)",
        "url": "https://fermlya.netlify.app",
        "logo": "https://fermlya.netlify.app/assets/images/logo.png",
        "description": "Plateforme de mise en relation dans l'aide à la personne et soins à domicile au Maroc.",
        "areaServed": ["Casablanca", "Rabat", "Marrakech", "Tanger", "Agadir", "Fès", "Meknès", "Oujda"]
      }

  body
    // Hidden Netlify Forms setup for Static Parser Indexing
    form(name="client-leads", netlify, netlify-honeypot="bot-field", hidden)
      input(type="text", name="form-name", value="client-leads")
      input(type="text", name="bot-field")
      input(type="text", name="fullName")
      input(type="tel", name="phone")
      input(type="text", name="city")
      input(type="text", name="serviceType")
      input(type="text", name="urgency")
      textarea(name="details")

    form(name="caregiver-leads", netlify, netlify-honeypot="bot-field", hidden)
      input(type="text", name="form-name", value="caregiver-leads")
      input(type="text", name="bot-field")
      input(type="text", name="fullName")
      input(type="tel", name="phone")
      input(type="text", name="profession")
      input(type="text", name="city")
      input(type="text", name="experience")
      textarea(name="bio")

    // Header Navigation
    include ../includes/header.pug

    // Main Page Content
    main#main-content
      block content

    // Lead Capture Modal Window
    include ../includes/lead-forms.pug

    // Footer
    include ../includes/footer.pug

    // Main JS Logic
    script(src="./assets/js/main.js")
