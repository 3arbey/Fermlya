header.site-header#site-header
  .container.header-container
    a.brand-logo(href="index.html")
      span.brand-icon-box
        svg.lucide-heart-handshake(xmlns="http://www.w3.org/2000/svg", width="22", height="22", viewBox="0 0 24 24", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
          path(d="M19.414 14.414C21 12.828 22 11.5 22 9.5a5.5 5.5 0 0 0-9.591-3.676.6.6 0 0 1-.818.001A5.5 5.5 0 0 0 2 9.5c0 2.3 1.5 4 3 5.5l5.535 5.362a2 2 0 0 0 2.879.052 2.12 2.12 0 0 0-.004-3 2.124 2.124 0 1 0 3-3 2.124 2.124 0 0 0 3.004 0 2 2 0 0 0 0-2.828l-1.881-1.882a2.41 2.41 0 0 0-3.409 0l-1.71 1.71a2 2 0 0 1-2.828 0 2 2 0 0 1 0-2.828l2.823-2.762")
      span.brand-title Mes soins

    nav.main-nav#main-nav
      ul.nav-list
        li: a.nav-link(href="#services", data-i18n="navServices") Services
        li: a.nav-link(href="#pricing", data-i18n="navPricing") Tarifs & Offres
        li: a.nav-link(href="#how-it-works", data-i18n="navHowItWorks") Comment ça marche
        li: a.nav-link(href="#cities", data-i18n="navCities") Villes
        li: a.nav-link(href="#trust", data-i18n="navTrust") Confiance

    .header-actions
      .language-selector
        a.lang-btn(href="index.html", data-lang="fr", class=lang === "fr" || !lang ? "active" : "") FR
        a.lang-btn(href="ar.html", data-lang="ar", class=lang === "ar" ? "active" : "") العربية
        a.lang-btn(href="en.html", data-lang="en", class=lang === "en" ? "active" : "") EN

      button.btn.btn-outline.open-modal-btn(data-tab="caregiver", data-i18n="navPro") Je suis professionnel
      button.btn.btn-primary.open-modal-btn(data-tab="client", data-i18n="navClient") Je cherche de l'aide

      button.mobile-toggle#mobile-toggle(aria-label="Menu")
        span.hamburger-bar
        span.hamburger-bar
        span.hamburger-bar
